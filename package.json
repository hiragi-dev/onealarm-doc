{
  "name": "onealarm-doc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lp:dev": "vite --config site/vite.config.ts",
    "lp:build": "vite build --config site/vite.config.ts",
    "lp:preview": "vite preview --config site/vite.config.ts --port 4173",
    "docs:dev": "vitepress dev docs --port 5174",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --port 4174",
    "build": "npm run lp:build && npm run docs:build",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "puppeteer-core": "^25.11.0",
    "vite": "^5.4.21",
    "vitepress": "^1.6.4"
  }
}
